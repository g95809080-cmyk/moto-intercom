<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/settings_scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="false">

    <LinearLayout
        android:id="@+id/settings_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="@dimen/motocom_page_horizontal_padding"
        android:paddingTop="@dimen/motocom_page_vertical_padding"
        android:paddingRight="@dimen/motocom_page_horizontal_padding"
        android:paddingBottom="32dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/settings_back_button"
                android:layout_width="@dimen/motocom_icon_button_size"
                android:layout_height="@dimen/motocom_icon_button_size"
                android:background="@drawable/motocom_icon_button"
                android:contentDescription="@string/back_button_description"
                android:padding="12dp"
                android:src="@drawable/ic_arrow_back_24" />

            <TextView
                android:id="@+id/settings_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/motocom_gap"
                android:layout_marginEnd="@dimen/motocom_gap"
                android:layout_weight="1"
                android:gravity="center"
                android:text="@string/nav_settings"
                android:textColor="@color/motocom_text_primary"
                android:textSize="22sp"
                android:textStyle="bold" />

            <View
                android:id="@+id/settings_header_end_spacer"
                android:layout_width="@dimen/motocom_icon_button_size"
                android:layout_height="@dimen/motocom_icon_button_size"
                android:importantForAccessibility="no" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/motocom_gap_large"
            android:background="@drawable/motocom_card"
            android:orientation="vertical"
            android:padding="@dimen/motocom_card_padding">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings_personal_nickname"
                android:textColor="@color/motocom_text_primary"
                android:textSize="17sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/settings_nickname_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/motocom_gap"
                android:background="@drawable/motocom_card_soft"
                android:hint="@string/edit_text_hint"
                android:importantForAutofill="no"
                android:inputType="textCapWords"
                android:minHeight="@dimen/motocom_control_min_height"
                android:paddingLeft="12dp"
                android:paddingRight="12dp"
                android:singleLine="true"
                android:textColor="@color/motocom_text_primary"
                android:textColorHint="@color/motocom_text_muted_accessible"
                android:textSize="16sp" />

            <Button
                android:id="@+id/settings_save_nickname_button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/motocom_gap"
                android:background="@drawable/motocom_primary_button"
                android:text="@string/settings_save_nickname"
                android:textAllCaps="false"
                android:textColor="@color/motocom_text_primary"
                android:textStyle="bold"
                android:minHeight="@dimen/motocom_control_min_height" />

            <TextView
                android:id="@+id/settings_nickname_feedback"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="@color/motocom_text_secondary"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/settings_vox_section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/motocom_gap"
            android:background="@drawable/motocom_card"
            android:orientation="vertical"
            android:padding="@dimen/motocom_card_padding">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/section_vox"
                android:textColor="@color/motocom_text_primary"
                android:textSize="17sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/settings_vox_button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/motocom_gap"
                android:background="@drawable/motocom_secondary_button"
                android:contentDescription="@string/vox_developing_description"
                android:drawableStart="@drawable/ic_mic_24"
                android:drawableTint="@color/motocom_text_muted_accessible"
                android:drawablePadding="8dp"
                android:text="@string/settings_vox_switch_developing"
                android:textAllCaps="false"
                android:textColor="@color/motocom_text_primary"
                android:minHeight="@dimen/motocom_control_min_height" />

            <Button
                android:id="@+id/settings_vox_sensitivity_button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/motocom_secondary_button"
                android:contentDescription="@string/vox_sensitivity_developing_description"
                android:drawableStart="@drawable/ic_tune_24"
                android:drawableTint="@color/motocom_text_muted_accessible"
                android:drawablePadding="8dp"
                android:text="@string/settings_vox_sensitivity_developing"
                android:textAllCaps="false"
                android:textColor="@color/motocom_text_primary"
                android:minHeight="@dimen/motocom_control_min_height" />

            <Button
                android:id="@+id/settings_vox_state_button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/motocom_secondary_button"
                android:contentDescription="@string/vox_state_developing_description"
                android:drawableStart="@drawable/ic_info_24"
                android:drawableTint="@color/motocom_text_muted_accessible"
                android:drawablePadding="8dp"
                android:text="@string/settings_vox_pending_developing"
                android:textAllCaps="false"
                android:textColor="@color/motocom_text_primary"
                android:minHeight="@dimen/motocom_control_min_height" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/settings_audio_section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/motocom_gap"
            android:background="@drawable/motocom_card"
            android:orientation="vertical"
            android:padding="@dimen/motocom_card_padding">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/section_audio_output"
                android:textColor="@color/motocom_text_primary"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/settings_audio_source"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/motocom_gap"
                android:textColor="@color/motocom_text_primary"
                android:textSize="15sp" />

            <Button
                android:id="@+id/settings_audio_route_button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/motocom_gap"
                android:background="@drawable/motocom_secondary_button"
                android:contentDescription="@string/audio_route_developing_description"
                android:drawableStart="@drawable/ic_audio_24"
                android:drawableTint="@color/motocom_text_muted_accessible"
                android:drawablePadding="8dp"
                android:text="@string/settings_audio_bluetooth_developing"
                android:textAllCaps="false"
                android:textColor="@color/motocom_text_primary"
                android:minHeight="@dimen/motocom_control_min_height" />

            <Button
                android:id="@+id/settings_audio_earpiece_button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/motocom_secondary_button"
                android:contentDescription="@string/audio_earpiece_developing_description"
                android:drawableStart="@drawable/ic_audio_24"
                android:drawableTint="@color/motocom_text_muted_accessible"
                android:drawablePadding="8dp"
                android:text="@string/settings_audio_earpiece_developing"
                android:textAllCaps="false"
                android:textColor="@color/motocom_text_primary"
                android:minHeight="@dimen/motocom_control_min_height" />

            <Button
                android:id="@+id/settings_audio_speaker_button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/motocom_secondary_button"
                android:contentDescription="@string/audio_speaker_developing_description"
                android:drawableStart="@drawable/ic_audio_24"
                android:drawableTint="@color/motocom_text_muted_accessible"
                android:drawablePadding="8dp"
                android:text="@string/settings_audio_speaker_developing"
                android:textAllCaps="false"
                android:textColor="@color/motocom_text_primary"
                android:minHeight="@dimen/motocom_control_min_height" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/motocom_gap"
            android:background="@drawable/motocom_card"
            android:orientation="vertical"
            android:padding="@dimen/motocom_card_padding">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings_connection_device"
                android:textColor="@color/motocom_text_primary"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/settings_product_state"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/motocom_gap"
                android:textColor="@color/motocom_text_primary"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/settings_attempt_facts"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="@color/motocom_text_secondary"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/settings_discovery_candidates"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="@color/motocom_text_secondary"
                android:textSize="14sp" />

            <Button
                android:id="@+id/settings_reconnect_button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/motocom_gap"
                android:background="@drawable/motocom_secondary_button"
                android:contentDescription="@string/reconnect_developing_description"
                android:drawableStart="@drawable/ic_radar_24"
                android:drawableTint="@color/motocom_text_muted_accessible"
                android:drawablePadding="8dp"
                android:text="@string/settings_auto_reconnect_developing"
                android:textAllCaps="false"
                android:textColor="@color/motocom_text_primary"
                android:minHeight="@dimen/motocom_control_min_height" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/settings_device_status_section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/motocom_gap"
            android:background="@drawable/motocom_card"
            android:orientation="vertical"
            android:padding="@dimen/motocom_card_padding">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings_device_status"
                android:textColor="@color/motocom_text_primary"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/settings_device_status_summary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/motocom_gap"
                android:textColor="@color/motocom_text_primary"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/settings_optional_permission_notice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/motocom_gap"
                android:textColor="@color/motocom_text_secondary"
                android:textSize="14sp"
                android:visibility="gone" />

            <Button
                android:id="@+id/settings_optional_permission_button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/motocom_gap"
                android:background="@drawable/motocom_secondary_button"
                android:text="@string/settings_optional_permission_grant"
                android:textAllCaps="false"
                android:textColor="@color/motocom_text_primary"
                android:minHeight="@dimen/motocom_control_min_height"
                android:visibility="gone" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/settings_advanced_section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/motocom_gap"
            android:background="@drawable/motocom_card"
            android:orientation="vertical"
            android:padding="@dimen/motocom_card_padding">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/section_advanced_settings"
                android:textColor="@color/motocom_text_primary"
                android:textSize="17sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/settings_logs_button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/motocom_gap"
                android:background="@drawable/motocom_secondary_button"
                android:text="@string/settings_logs"
                android:textAllCaps="false"
                android:textColor="@color/motocom_text_primary"
                android:minHeight="@dimen/motocom_control_min_height" />

            <Button
                android:id="@+id/settings_help_button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/motocom_secondary_button"
                android:contentDescription="@string/help_developing_description"
                android:drawableStart="@drawable/ic_info_24"
                android:drawableTint="@color/motocom_text_muted_accessible"
                android:drawablePadding="8dp"
                android:text="@string/settings_help_developing"
                android:textAllCaps="false"
                android:textColor="@color/motocom_text_primary"
                android:minHeight="@dimen/motocom_control_min_height" />

            <Button
                android:id="@+id/settings_about_button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/motocom_secondary_button"
                android:text="@string/settings_about"
                android:textAllCaps="false"
                android:textColor="@color/motocom_text_primary"
                android:minHeight="@dimen/motocom_control_min_height" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/settings_version_section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/motocom_gap"
            android:background="@drawable/motocom_card_soft"
            android:orientation="vertical"
            android:padding="@dimen/motocom_card_padding">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings_app_version"
                android:textColor="@color/motocom_text_primary"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/settings_version_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="@color/motocom_text_secondary"
                android:textSize="14sp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
