<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/discover_scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="false">

    <LinearLayout
        android:id="@+id/discover_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="@dimen/motocom_page_horizontal_padding"
        android:paddingTop="@dimen/motocom_page_vertical_padding"
        android:paddingRight="@dimen/motocom_page_horizontal_padding"
        android:paddingBottom="32dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/discover_back_button"
                android:layout_width="@dimen/motocom_icon_button_size"
                android:layout_height="@dimen/motocom_icon_button_size"
                android:background="@drawable/motocom_icon_button"
                android:contentDescription="@string/back_button_description"
                android:padding="12dp"
                android:src="@drawable/ic_arrow_back_24" />

            <TextView
                android:id="@+id/discover_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/motocom_gap"
                android:layout_marginEnd="@dimen/motocom_gap"
                android:layout_weight="1"
                android:gravity="center"
                android:text="@string/nav_discover"
                android:textColor="@color/motocom_text_primary"
                android:textSize="22sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/discover_help_button"
                android:layout_width="@dimen/motocom_icon_button_size"
                android:layout_height="@dimen/motocom_icon_button_size"
                android:background="@drawable/motocom_icon_button"
                android:contentDescription="@string/help_developing_description"
                android:padding="12dp"
                android:src="@drawable/ic_info_24" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/motocom_gap_large"
            android:background="@drawable/motocom_card"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="@dimen/motocom_card_padding">

            <FrameLayout
                android:layout_width="96dp"
                android:layout_height="96dp"
                android:importantForAccessibility="no">

                <com.kuma.motointercom.RippleView
                    android:id="@+id/discover_radar_ripple"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:importantForAccessibility="no" />

                <ImageView
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_radar_24" />
            </FrameLayout>

            <TextView
                android:id="@+id/discover_state_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/motocom_gap"
                android:gravity="center"
                android:textColor="@color/motocom_text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/discover_status_supplemental"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:textColor="@color/motocom_text_secondary"
                android:textSize="14sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/discover_notice_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:text="@string/discover_identity_notice"
                android:textColor="@color/motocom_text_secondary"
                android:textSize="14sp" />

            <Button
                android:id="@+id/discover_offline_start_button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/motocom_gap"
                android:background="@drawable/motocom_primary_button"
                android:text="@string/discover_start"
                android:textAllCaps="false"
                android:textColor="@color/motocom_text_primary"
                android:textStyle="bold"
                android:minHeight="@dimen/motocom_control_min_height"
                android:visibility="gone" />

            <Button
                android:id="@+id/discover_wifi_settings_button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/motocom_gap"
                android:background="@drawable/motocom_secondary_button"
                android:text="@string/wifi_settings_cta"
                android:textAllCaps="false"
                android:textColor="@color/motocom_text_primary"
                android:minHeight="@dimen/motocom_control_min_height"
                android:visibility="gone" />
        </LinearLayout>

        <TextView
            android:id="@+id/discover_paired_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/motocom_gap_large"
            android:text="@string/discover_paired_title"
            android:textColor="@color/motocom_text_primary"
            android:textSize="17sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/discover_paired_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/discover_nearby_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/motocom_gap_large"
            android:text="@string/discover_nearby_title"
            android:textColor="@color/motocom_text_primary"
            android:textSize="17sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/discover_nearby_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/discover_offline_paired_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/motocom_gap_large"
            android:text="@string/discover_offline_paired_title"
            android:textColor="@color/motocom_text_primary"
            android:textSize="17sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/discover_offline_paired_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/discover_empty_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/motocom_gap"
            android:background="@drawable/motocom_card_soft"
            android:gravity="center"
            android:padding="@dimen/motocom_card_padding"
            android:textColor="@color/motocom_text_secondary"
            android:textSize="14sp" />

        <Button
            android:id="@+id/discover_rescan_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/motocom_gap"
            android:background="@drawable/motocom_secondary_button"
            android:contentDescription="@string/rescan_developing_description"
            android:drawableStart="@drawable/ic_radar_24"
            android:drawableTint="@color/motocom_text_muted_accessible"
            android:drawablePadding="8dp"
            android:text="@string/discover_rescan"
            android:textAllCaps="false"
            android:textColor="@color/motocom_text_primary"
            android:minHeight="@dimen/motocom_control_min_height" />

        <TextView
            android:id="@+id/discover_one_to_one_note"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/motocom_gap"
            android:background="@drawable/motocom_card_soft"
            android:padding="@dimen/motocom_card_padding"
            android:text="@string/discover_one_to_one_note"
            android:textColor="@color/motocom_text_secondary"
            android:textSize="14sp" />
    </LinearLayout>
</ScrollView>
