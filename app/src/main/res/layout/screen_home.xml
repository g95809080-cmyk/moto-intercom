<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/home_scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="false">

    <LinearLayout
        android:id="@+id/home_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="@dimen/motocom_page_horizontal_padding"
        android:paddingTop="@dimen/motocom_page_vertical_padding"
        android:paddingRight="@dimen/motocom_page_horizontal_padding"
        android:paddingBottom="32dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/home_menu_button"
                android:layout_width="@dimen/motocom_icon_button_size"
                android:layout_height="@dimen/motocom_icon_button_size"
                android:background="@drawable/motocom_icon_button"
                android:contentDescription="@string/menu_button_description"
                android:padding="12dp"
                android:src="@drawable/ic_menu_24" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/motocom_gap"
                android:layout_marginEnd="@dimen/motocom_gap"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/brand_name"
                    android:textColor="@color/motocom_text_primary"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/home_status_capsule"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/motocom_pill_green"
                    android:paddingLeft="12dp"
                    android:paddingTop="5dp"
                    android:paddingRight="12dp"
                    android:paddingBottom="5dp"
                    android:text="@string/brand_tagline"
                    android:textColor="@color/motocom_text_primary"
                    android:textSize="13sp" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/home_settings_button"
                android:layout_width="@dimen/motocom_icon_button_size"
                android:layout_height="@dimen/motocom_icon_button_size"
                android:background="@drawable/motocom_icon_button"
                android:contentDescription="@string/settings_button_description"
                android:padding="12dp"
                android:src="@drawable/ic_settings_24" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/motocom_gap_large"
            android:background="@drawable/motocom_card"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="@dimen/motocom_home_card_padding">

            <TextView
                android:id="@+id/home_status_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/motocom_gap"
                android:gravity="center"
                android:textColor="@color/motocom_text_primary"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/home_status_detail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:textColor="@color/motocom_text_secondary"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/home_status_supplemental"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:textColor="@color/motocom_text_muted_accessible"
                android:textSize="13sp"
                android:visibility="gone" />

            <FrameLayout
                android:layout_width="@dimen/motocom_avatar_size"
                android:layout_height="@dimen/motocom_avatar_size"
                android:layout_marginTop="@dimen/motocom_gap"
                android:importantForAccessibility="no">

                <com.kuma.motointercom.RippleView
                    android:id="@+id/home_ripple"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <ImageView
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_rider_24" />
            </FrameLayout>

            <TextView
                android:id="@+id/home_peer_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textColor="@color/motocom_text_primary"
                android:textSize="24sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/home_connection_facts"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/motocom_gap_large"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/home_transport_pill"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@drawable/motocom_pill_gray"
                        android:padding="@dimen/motocom_home_fact_padding"
                        android:textColor="@color/motocom_text_primary"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/home_connected_transport"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/motocom_pill_gray"
                        android:padding="@dimen/motocom_home_fact_padding"
                        android:textColor="@color/motocom_text_primary"
                        android:textSize="14sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/motocom_home_compact_gap"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/home_webrtc_pill"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@drawable/motocom_pill_gray"
                        android:padding="@dimen/motocom_home_fact_padding"
                        android:textColor="@color/motocom_text_primary"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/home_bluetooth_pill"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/motocom_pill_gray"
                        android:padding="@dimen/motocom_home_fact_padding"
                        android:textColor="@color/motocom_text_primary"
                        android:textSize="14sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/home_vox_pill"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/motocom_home_compact_gap"
                    android:background="@drawable/motocom_pill_gray"
                    android:clickable="true"
                    android:contentDescription="@string/vox_developing_description"
                    android:drawableStart="@drawable/ic_info_24"
                    android:drawableTint="@color/motocom_text_muted_accessible"
                    android:drawablePadding="8dp"
                    android:focusable="true"
                    android:minHeight="@dimen/motocom_control_min_height"
                    android:padding="@dimen/motocom_home_fact_padding"
                    android:textColor="@color/motocom_text_primary"
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/home_audio_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/motocom_gap"
            android:background="@drawable/motocom_card"
            android:orientation="vertical"
            android:padding="@dimen/motocom_home_audio_padding">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/section_audio_output"
                android:textColor="@color/motocom_text_primary"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/home_audio_source"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/motocom_home_compact_gap"
                android:textColor="@color/motocom_text_primary"
                android:textSize="15sp"
                android:textStyle="bold" />

            <com.kuma.motointercom.VisualizerView
                android:id="@+id/home_visualizer"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginTop="@dimen/motocom_home_compact_gap"
                android:importantForAccessibility="no" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/home_main_control_section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/motocom_gap"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/home_main_control_row"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/home_mute_button"
                    android:layout_width="@dimen/motocom_icon_button_size"
                    android:layout_height="@dimen/motocom_icon_button_size"
                    android:background="@drawable/motocom_icon_button"
                    android:contentDescription="@string/mute_developing_description"
                    android:padding="12dp"
                    android:src="@drawable/ic_mute_24" />

                <Button
                    android:id="@+id/home_primary_button"
                    android:layout_width="@dimen/motocom_main_control_size"
                    android:layout_height="@dimen/motocom_main_control_size"
                    android:layout_marginStart="@dimen/motocom_main_control_gap"
                    android:layout_marginEnd="@dimen/motocom_main_control_gap"
                    android:background="@drawable/motocom_primary_circle"
                    android:gravity="center"
                    android:textAllCaps="false"
                    android:textColor="@color/motocom_text_primary"
                    android:textStyle="bold" />

                <ImageButton
                    android:id="@+id/home_audio_settings_button"
                    android:layout_width="@dimen/motocom_icon_button_size"
                    android:layout_height="@dimen/motocom_icon_button_size"
                    android:background="@drawable/motocom_icon_button"
                    android:contentDescription="@string/audio_button_description"
                    android:padding="12dp"
                    android:src="@drawable/ic_audio_24" />
            </LinearLayout>

            <TextView
                android:id="@+id/home_disabled_reason"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:textColor="@color/motocom_text_secondary"
                android:textSize="13sp"
                android:visibility="gone" />

            <Button
                android:id="@+id/home_permission_grant_cta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/motocom_gap"
                android:background="@drawable/motocom_secondary_button"
                android:text="@string/home_permission_grant_cta"
                android:textAllCaps="false"
                android:textColor="@color/motocom_text_primary"
                android:minHeight="@dimen/motocom_control_min_height"
                android:visibility="gone" />

            <Button
                android:id="@+id/home_permission_settings_cta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/motocom_gap"
                android:background="@drawable/motocom_secondary_button"
                android:text="@string/home_permission_settings_cta"
                android:textAllCaps="false"
                android:textColor="@color/motocom_text_primary"
                android:minHeight="@dimen/motocom_control_min_height"
                android:visibility="gone" />

            <Button
                android:id="@+id/home_wifi_settings_cta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/motocom_gap"
                android:background="@drawable/motocom_secondary_button"
                android:text="@string/wifi_settings_cta"
                android:textAllCaps="false"
                android:textColor="@color/motocom_text_primary"
                android:minHeight="@dimen/motocom_control_min_height"
                android:visibility="gone" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/home_vox_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/motocom_gap"
            android:background="@drawable/motocom_card"
            android:clickable="true"
            android:contentDescription="@string/vox_developing_description"
            android:focusable="true"
            android:minHeight="@dimen/motocom_control_min_height"
            android:orientation="vertical"
            android:padding="@dimen/motocom_card_padding">

            <TextView
                android:id="@+id/home_vox_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:drawableStart="@drawable/ic_mic_24"
                android:drawableTint="@color/motocom_text_muted_accessible"
                android:drawablePadding="8dp"
                android:text="@string/section_vox"
                android:textColor="@color/motocom_text_primary"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/home_vox_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="@color/motocom_text_secondary"
                android:textSize="14sp" />

            <LinearLayout
                android:id="@+id/home_vox_state_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/motocom_gap"
                android:importantForAccessibility="no"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/motocom_pill_gray"
                    android:gravity="center"
                    android:minHeight="40dp"
                    android:padding="8dp"
                    android:text="@string/home_vox_listening_placeholder"
                    android:textColor="@color/motocom_text_secondary"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/motocom_pill_gray"
                    android:gravity="center"
                    android:minHeight="40dp"
                    android:padding="8dp"
                    android:text="@string/home_vox_open_placeholder"
                    android:textColor="@color/motocom_text_secondary"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/motocom_pill_gray"
                    android:gravity="center"
                    android:minHeight="40dp"
                    android:padding="8dp"
                    android:text="@string/home_vox_hangover_placeholder"
                    android:textColor="@color/motocom_text_secondary"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/home_vox_placeholder_note"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/home_vox_placeholder_note"
                android:textColor="@color/motocom_text_muted_accessible"
                android:textSize="13sp" />
        </LinearLayout>

        <Button
            android:id="@+id/home_discover_cta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/motocom_gap"
            android:background="@drawable/motocom_secondary_button"
            android:text="@string/home_discover_cta"
            android:textAllCaps="false"
            android:textColor="@color/motocom_text_primary"
            android:minHeight="@dimen/motocom_control_min_height"
            android:visibility="gone" />
    </LinearLayout>
</ScrollView>
