<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <solid android:color="@color/motocom_accent_green_pressed" />
            <corners android:radius="24dp" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="@color/motocom_surface" />
            <stroke
                android:width="1dp"
                android:color="@color/motocom_border" />
            <corners android:radius="24dp" />
        </shape>
    </item>
</selector>
